# Puerto HTTP en el que escuchará el servidor de la aplicación
PORT=3001
# Cadena de conexión a MongoDB (usuario, contraseña y base de datos)
MONGODB_URI=
# Clave de API de OpenAI para llamadas al modelo
OPENAI_API_KEY=
# Modelo de OpenAI a usar en las respuestas (por defecto gpt-6-luna)
OPENAI_MODEL=gpt-6-luna
